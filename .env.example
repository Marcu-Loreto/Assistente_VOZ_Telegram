# === Telegram ===
TELEGRAM_BOT_TOKEN=

# === LLM via OpenRouter (cérebro do assistente) ===
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.6-luna

# === Seleção de provedores de voz (chave seletora) ===
# STT (voz -> texto): openai | cpqd
STT_PROVIDER=openai
# TTS (texto -> voz): elevenlabs | cpqd
TTS_PROVIDER=elevenlabs

# === OpenAI direto (transcrição de voz — usado quando STT_PROVIDER=openai) ===
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-transcribe

# === Visão / OCR de imagens (via OpenRouter, usado ao ingerir imagens no RAG) ===
# Modelo multimodal que descreve a imagem e extrai o texto embutido (OCR).
VISION_MODEL=openai/gpt-4o-mini
# Pré-processamento antes de enviar ao modelo (reduz custo e latência):
# lado máximo em pixels (imagens maiores são reduzidas mantendo a proporção)
VISION_MAX_IMAGE_PX=1536
# qualidade JPEG (1-95) usada ao recomprimir imagens sem transparência
VISION_IMAGE_QUALITY=85

# === Embeddings da RAG (locais, via sentence-transformers — sem custo de API) ===
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# === ElevenLabs (voz de saída — usado quando TTS_PROVIDER=elevenlabs) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Qrdut83w0Cr152Yb4Xn3
ELEVENLABS_MODEL=eleven_turbo_v2_5

# === CPQD (STT e/ou TTS — usado quando STT_PROVIDER=cpqd ou TTS_PROVIDER=cpqd) ===
# A plataforma CPQD emite credenciais SEPARADAS por serviço (ASR e TTS) e autentica
# por HTTP Basic no endpoint de auth, devolvendo um token bearer.
# Requer ffmpeg instalado no sistema (converte o áudio do Telegram <-> WAV do CPQD).
CPQD_AUTH_URL=https://speechp.cpqd.com.br/auth/token
# STT (ASR)
I2_ASR_USER=
I2_ASR_PASSWORD=
CPQD_ASR_URL=https://asr.cpqd.com.br/asr-general
CPQD_ASR_LM=builtin:slm/general
# TTS
I2_TTS_USER=
I2_TTS_PASSWORD=
CPQD_TTS_URL=https://tts.cpqd.com.br/rest/v2/synthesize
CPQD_TTS_VOICE=CPQD-ADRIANA-PT-NAT-NEU-BAI-PRF
# Tempo limite (segundos) das chamadas ao CPQD
CPQD_TIMEOUT_SECONDS=15

# === RAG ===
RAG_DIR=rag
CHROMA_DIR=chroma_db
RAG_TOP_K=4

# Usuários com acesso à gestão do RAG (CRUD) no frontend Streamlit.
# Lista separada por vírgula. Login sem senha (POC): basta o nome estar aqui.
# Ex.: RAG_ADMIN_USERS=marcu,admin
RAG_ADMIN_USERS=admin

# === Comportamento ===
SYSTEM_PROMPT_PATH=prompt/agente.md
HISTORY_MAX_MESSAGES=10
MAX_AUDIO_SECONDS=120



#waba
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=        # você inventa
WHATSAPP_APP_SECRET=          # do painel do app Meta (validação de assinatura)
WHATSAPP_API_VERSION=v21.0
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
