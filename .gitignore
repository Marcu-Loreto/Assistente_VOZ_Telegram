# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# RAG vector store (dados gerados pela ingestão)
chroma_db/

# Logs (podem conter o token do bot em texto claro nas URLs do httpx)
logs/

# Relatórios de code review (artefato de processo, não faz parte do projeto)
semantic-review/

# Skills locais (superpowers) — não fazem parte do projeto
skills/

# Documentos-fonte da RAG (grandes; cada um usa os seus e roda a ingestão)
rag/*.pdf
rag/*.txt
rag/*.md
!rag/.gitkeep
